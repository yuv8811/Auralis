{%- if settings.enable_back_to_top -%}
  <back-to-top class="back-to-top-wrapper">
    <button type="button" class="back-to-top-btn" aria-label="{{ 'general.back_to_top' | t }}">
      {% render 'icon', icon: 'arrow-up', class: 'icon icon--small' %}
    </button>
  </back-to-top>

  <style>
    .back-to-top-wrapper {
      position: fixed;
      bottom: 2rem;
      right: 2rem;
      z-index: 800;
      opacity: 0;
      visibility: hidden;
      transform: translateY(10px);
      transition: all var(--transition-fast);
    }
    .back-to-top-wrapper.is-visible {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
    }
    .back-to-top-btn {
      width: 3rem;
      height: 3rem;
      border-radius: var(--radius-pill);
      background-color: var(--color-button-bg);
      color: var(--color-button-text);
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: var(--shadow-md);
      cursor: pointer;
    }
  </style>
{%- endif -%}

{% schema %}
{
  "name": "Back to top",
  "settings": []
}
{% endschema %}
