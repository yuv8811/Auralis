<div class="contact-section color-{{ section.settings.color_scheme }} section-spacing">
  <div class="page-width" style="max-width: 720px;">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="text-center" style="margin-bottom: var(--space-8);">
        {%- if section.settings.subheading != blank -%}
          <p class="caption" style="text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; margin-bottom: 0.5rem;">
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 style="font-size: var(--font-size-2xl);">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    {% form 'contact', id: 'ContactFormSection', class: 'contact-form' %}
      {%- if form.posted_successfully? -%}
        <div class="form-status form-status--success text-center" tabindex="-1" autofocus style="padding: 1rem; background: rgba(46, 125, 50, 0.1); border-radius: var(--radius-md); margin-bottom: 2rem;">
          {{ 'templates.contact.form.post_success' | t }}
        </div>
      {%- elsif form.errors -%}
        <div class="form-status form-status--error" tabindex="-1" autofocus style="margin-bottom: 2rem;">
          {{ form.errors | default_errors }}
        </div>
      {%- endif -%}

      <div class="grid grid--2-col">
        <div class="field">
          <label class="field__label" for="ContactFormSection-name">{{ 'templates.contact.form.name' | t }}</label>
          <input type="text" id="ContactFormSection-name" name="contact[{{ 'templates.contact.form.name' | t }}]" class="field__input" value="{% if form.name %}{{ form.name }}{% elsif customer %}{{ customer.name }}{% endif %}">
        </div>
        <div class="field">
          <label class="field__label" for="ContactFormSection-email">{{ 'templates.contact.form.email' | t }}</label>
          <input type="email" id="ContactFormSection-email" name="contact[email]" class="field__input" spellcheck="false" autocomplete="email" value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}" required>
        </div>
      </div>

      <div class="field">
        <label class="field__label" for="ContactFormSection-body">{{ 'templates.contact.form.comment' | t }}</label>
        <textarea id="ContactFormSection-body" name="contact[{{ 'templates.contact.form.comment' | t }}]" rows="5" class="field__input" required>{{ form.body }}</textarea>
      </div>

      <button type="submit" class="button button--primary button--full">
        <span>{{ 'templates.contact.form.send' | t }}</span>
      </button>
    {% endform %}
  </div>
</div>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" },
        { "value": "scheme-5", "label": "Scheme 5" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Get In Touch",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Concierge & Client Services",
      "label": "Heading"
    }
  ],
  "presets": [
    {
      "name": "Contact form"
    }
  ]
}
{% endschema %}
