<div class="password-main color-{{ section.settings.color_scheme }} section-spacing text-center">
  <div class="page-width" style="max-width: 500px;">
    <h1 style="margin-bottom: 1rem;">{{ shop.name }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="caption" style="margin-bottom: 2rem;">{{ shop.password_message }}</p>
    {%- endif -%}

    <div style="margin-top: 2rem;">
      <h2 style="font-size: var(--font-size-md); margin-bottom: 1rem;">{{ 'general.password_page.login_form_heading' | t }}</h2>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}
          <div class="form-status form-status--error" tabindex="-1" autofocus style="margin-bottom: 1rem;">
            {{ form.errors | default_errors }}
          </div>
        {%- endif -%}
        <div class="field">
          <label class="visually-hidden" for="password">{{ 'general.password_page.login_form_password_label' | t }}</label>
          <input
            type="password"
            name="password"
            id="password"
            class="field__input text-center"
            placeholder="{{ 'general.password_page.login_form_password_placeholder' | t }}"
            required>
        </div>
        <button type="submit" name="commit" class="button button--primary button--full">
          <span>{{ 'general.password_page.login_form_submit' | t }}</span>
        </button>
      {%- endform -%}
    </div>

    <div class="caption" style="margin-top: 2rem; opacity: 0.8;">
      {{ 'general.password_page.admin_link_html' | t }}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Password page",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" },
        { "value": "scheme-5", "label": "Scheme 5" }
      ],
      "default": "scheme-1"
    }
  ]
}
{% endschema %}

