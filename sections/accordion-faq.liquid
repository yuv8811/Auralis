<div class="accordion-faq color-{{ section.settings.color_scheme }} section-spacing">
  <div class="page-width" style="max-width: 800px;">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="text-center" style="margin-bottom: var(--space-8);">
        {%- if section.settings.subheading != blank -%}
          <p class="caption" style="text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; margin-bottom: 0.5rem;">
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 style="font-size: var(--font-size-2xl);">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="faq-list">
      {%- for block in section.blocks -%}
        <div class="product__accordion" {{ block.shopify_attributes }}>
          <details>
            <summary style="font-size: var(--font-size-md);">
              <span>{{ block.settings.question | escape }}</span>
              {% render 'icon', icon: 'chevron-down', class: 'icon icon--small' %}
            </summary>
            <div class="product__accordion-content rte" style="padding-top: 0.5rem; opacity: 0.85;">
              {{ block.settings.answer }}
            </div>
          </details>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Accordion / FAQ",
  "max_blocks": 10,
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" },
        { "value": "scheme-5", "label": "Scheme 5" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Answers",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Frequently Asked Questions",
      "label": "Heading"
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Question",
      "settings": [
        {
          "type": "text",
          "id": "question",
          "default": "How should I care for my tailored garments?",
          "label": "Question"
        },
        {
          "type": "richtext",
          "id": "answer",
          "default": "<p>We advocate gentle steaming, cedar wardrobe hanging, and localized spot cleaning to extend garment life.</p>",
          "label": "Answer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Accordion / FAQ",
      "blocks": [
        { "type": "item" },
        { "type": "item" },
        { "type": "item" }
      ]
    }
  ]
}
{% endschema %}
