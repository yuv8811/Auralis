{%- if settings.enable_cookie_banner -%}
  <div id="CookieConsentBanner" class="cookie-banner color-{{ section.settings.color_scheme }}" role="region" aria-label="Privacy Consent" hidden>
    <div class="page-width cookie-banner__content">
      <p class="cookie-banner__text">
        {{ 'newsletter.cookie_banner.text' | t }}
      </p>
      <div class="cookie-banner__buttons">
        <button type="button" class="button button--primary button--small" id="AcceptCookies">
          <span>{{ 'newsletter.cookie_banner.accept' | t }}</span>
        </button>
        <button type="button" class="button button--secondary button--small" id="DeclineCookies">
          <span>{{ 'newsletter.cookie_banner.decline' | t }}</span>
        </button>
      </div>
    </div>
  </div>

  <style>
    .cookie-banner {
      position: fixed;
      bottom: 0;
      left: 0;
      width: 100%;
      z-index: 9999;
      border-top: 1px solid var(--color-border);
      padding: 1rem 0;
      box-shadow: var(--shadow-lg);
    }
    .cookie-banner__content {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      align-items: center;
      justify-content: space-between;
    }
    @media screen and (min-width: 750px) {
      .cookie-banner__content {
        flex-direction: row;
      }
    }
    .cookie-banner__buttons {
      display: flex;
      gap: 0.5rem;
    }
  </style>

  <script>
    document.addEventListener('DOMContentLoaded', () => {
      const banner = document.getElementById('CookieConsentBanner');
      if (!banner) return;
      if (!localStorage.getItem('auralis_cookie_consent')) {
        banner.removeAttribute('hidden');
      }
      document.getElementById('AcceptCookies')?.addEventListener('click', () => {
        localStorage.setItem('auralis_cookie_consent', 'accepted');
        if (window.Shopify && window.Shopify.customerPrivacy) {
          window.Shopify.customerPrivacy.setTrackingConsent(true, () => {});
        }
        banner.setAttribute('hidden', 'true');
      });
      document.getElementById('DeclineCookies')?.addEventListener('click', () => {
        localStorage.setItem('auralis_cookie_consent', 'declined');
        if (window.Shopify && window.Shopify.customerPrivacy) {
          window.Shopify.customerPrivacy.setTrackingConsent(false, () => {});
        }
        banner.setAttribute('hidden', 'true');
      });
    });
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Cookie banner",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" },
        { "value": "scheme-5", "label": "Scheme 5" }
      ],
      "default": "scheme-1"
    }
  ]
}
{% endschema %}

