<div class="list-collections color-{{ section.settings.color_scheme }} section-spacing">
  <div class="page-width">
    <h1 class="text-center" style="margin-bottom: var(--space-8);">{{ 'general.breadcrumbs.collections' | t }}</h1>

    {% paginate collections by section.settings.collections_per_page %}
      <div class="grid grid--3-col grid--2-col">
        {%- for collection in collections -%}
          {% render 'collection-card', collection: collection %}
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "Collections list page",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" },
        { "value": "scheme-5", "label": "Scheme 5" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "collections_per_page",
      "min": 6,
      "max": 24,
      "step": 3,
      "default": 12,
      "label": "Collections per page"
    }
  ]
}
{% endschema %}

