<div class="template-404 color-{{ section.settings.color_scheme }} section-spacing text-center">
  <div class="page-width" style="max-width: 600px;">
    <p class="caption" style="font-size: var(--font-size-2xl); font-weight: 700; margin-bottom: 0.5rem;">404</p>
    <h1 class="template-404__title">{{ 'templates.404.title' | t }}</h1>
    <p class="template-404__subtext caption" style="margin-bottom: 2rem;">
      {{ 'templates.404.subtext' | t }}
    </p>
    {%- assign btn_text = 'templates.404.button' | t -%}
    {% render 'button', href: routes.root_url, text: btn_text, style: 'primary' %}
  </div>
</div>

{% schema %}
{
  "name": "404 page",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" },
        { "value": "scheme-5", "label": "Scheme 5" }
      ],
      "default": "scheme-1"
    }
  ]
}
{% endschema %}

