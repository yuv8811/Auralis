<div class="featured-blog-posts color-{{ section.settings.color_scheme }} section-spacing">
  <div class="page-width">
    {%- if section.settings.heading != blank or section.settings.subheading != blank -%}
      <div class="text-center" style="max-width: 600px; margin: 0 auto var(--space-8);">
        {%- if section.settings.subheading != blank -%}
          <p class="caption" style="text-transform: uppercase; letter-spacing: 0.1em; font-weight: 600; margin-bottom: 0.5rem;">
            {{ section.settings.subheading | escape }}
          </p>
        {%- endif -%}
        {%- if section.settings.heading != blank -%}
          <h2 style="font-size: var(--font-size-2xl);">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
      </div>
    {%- endif -%}

    <div class="grid grid--3-col grid--2-col">
      {%- assign target_blog = section.settings.blog -%}
      {%- if target_blog != blank and target_blog.articles_count > 0 -%}
        {%- for article in target_blog.articles limit: section.settings.post_limit -%}
          {% render 'article-card',
            article: article,
            show_image: section.settings.show_image,
            show_date: section.settings.show_date,
            show_author: section.settings.show_author,
            show_excerpt: section.settings.show_excerpt
          %}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <article class="card article-card">
            <div class="article-card__image-wrapper aspect-ratio" style="--aspect-ratio: 1.5;">
              {{ 'image' | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="article-card__content">
              <span class="caption" style="opacity: 0.7;">October 31, 2026</span>
              <h3 class="article-card__title">The Philosophy of Quiet Elegance</h3>
              <p class="caption" style="opacity: 0.85;">An inquiry into sustainable tailoring and timeless wardrobe foundations.</p>
            </div>
          </article>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Blog posts",
  "settings": [
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Color scheme",
      "options": [
        { "value": "scheme-1", "label": "Scheme 1" },
        { "value": "scheme-2", "label": "Scheme 2" },
        { "value": "scheme-3", "label": "Scheme 3" },
        { "value": "scheme-4", "label": "Scheme 4" },
        { "value": "scheme-5", "label": "Scheme 5" }
      ],
      "default": "scheme-1"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog"
    },
    {
      "type": "text",
      "id": "subheading",
      "default": "Editorial Journal",
      "label": "Subheading"
    },
    {
      "type": "text",
      "id": "heading",
      "default": "Dispatches & Stories",
      "label": "Heading"
    },
    {
      "type": "range",
      "id": "post_limit",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3,
      "label": "Number of posts to show"
    },
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show featured image",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_date",
      "label": "Show date",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_author",
      "label": "Show author",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_excerpt",
      "label": "Show excerpt",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Blog posts"
    }
  ]
}
{% endschema %}

