[
  {
    "name": "theme_info",
    "theme_name": "Auralis",
    "theme_version": "1.0.0",
    "theme_author": "Auralis Studio",
    "theme_documentation_url": "https://shopify.dev/themes",
    "theme_support_url": "https://shopify.dev/themes"
  },
  {
    "name": "Logo & Favicon",
    "settings": [
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 50,
        "max": 300,
        "step": 5,
        "default": 130,
        "unit": "px",
        "label": "Custom logo width"
      },
      {
        "type": "image_picker",
        "id": "logo_transparent",
        "label": "Inverted / Transparent header logo",
        "info": "Used when header is transparent over hero images."
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon image",
        "info": "Will be scaled down to 32 x 32px"
      }
    ]
  },
