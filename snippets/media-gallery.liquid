{% comment %}
  Renders product media gallery.
  Accepts:
  - product: {Object} Product Liquid object
  - layout: {String} 'stacked', 'thumbnails_bottom', 'thumbnails_left'
  - enable_zoom: {Boolean}
{% endcomment %}
{% liquid
  assign media_count = product.media.size
  assign selected_media = product.selected_or_first_available_variant.featured_media | default: product.featured_media
%}

<media-gallery
  id="MediaGallery-{{ section.id }}"
  class="media-gallery media-gallery--{{ layout | default: 'thumbnails_bottom' }}"
  data-zoom="{{ enable_zoom | default: true }}">
  <div class="media-gallery__viewer">
    <div class="media-gallery__main-list">
      {%- for media in product.media -%}
        <div
          class="media-gallery__item {% if media.id == selected_media.id %}is-active{% endif %}"
          data-media-id="{{ media.id }}"
          data-media-type="{{ media.media_type }}">
          {% case media.media_type %}
            {% when 'image' %}
              <div class="media-gallery__image-wrapper aspect-ratio" style="--aspect-ratio: {{ media.aspect_ratio | default: 1.0 }};">
                {% liquid
                  assign is_first = forloop.first
                  if is_first
                    render 'image', image: media, class: 'media-gallery__image', sizes: '(min-width: 1000px) 50vw, 100vw', loading: 'eager', fetchpriority: 'high'
                  else
                    render 'image', image: media, class: 'media-gallery__image', sizes: '(min-width: 1000px) 50vw, 100vw', loading: 'lazy'
                  endif
                %}
              </div>
            {% when 'video' %}
              <div class="media-gallery__video-wrapper">
                {{ media | video_tag: controls: true, image_size: '1000x' }}
              </div>
            {% when 'external_video' %}
              <div class="media-gallery__video-wrapper">
                {{ media | external_video_tag }}
              </div>
            {% when 'model' %}
              <div class="media-gallery__model-wrapper">
                {{ media | model_viewer_tag }}
              </div>
          {% endcase %}
        </div>
      {%- else -%}
        <div class="media-gallery__item is-active">
          {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
        </div>
      {%- endfor -%}
    </div>
  </div>

  {%- if media_count > 1 -%}
    <div class="media-gallery__thumbnails">
      <ul class="media-gallery__thumb-list list-unstyled" role="list">
        {%- for media in product.media -%}
          <li class="media-gallery__thumb-item">
            <button
              type="button"
              class="media-gallery__thumb-btn {% if media.id == selected_media.id %}is-active{% endif %}"
              data-target-id="{{ media.id }}"
              aria-label="{{ 'products.product.media.open_media' | t }}">
              {{ media.preview_image | image_url: width: 140, height: 140, crop: 'center' | image_tag: loading: 'lazy', alt: media.alt | default: product.title | escape }}
            </button>
          </li>
        {%- endfor -%}
      </ul>
    </div>
  {%- endif -%}
</media-gallery>

