{% comment %}
  Renders a collection card.
  Accepts:
  - collection: {Object} Collection Liquid object
  - image: {Object} Optional custom image
  - title: {String} Optional custom title
{% endcomment %}
{% liquid
  assign card_image = image | default: collection.featured_image | default: collection.products.first.featured_image
  assign card_title = title | default: collection.title | default: 'Collection'
%}

<div class="card collection-card">
  <a href="{{ collection.url | default: '#' }}" class="collection-card__link">
    <div class="collection-card__image-wrapper aspect-ratio" style="--aspect-ratio: 1.0;">
      {%- if card_image != blank -%}
        {% render 'image',
          image: card_image,
          class: 'collection-card__image',
          sizes: '(min-width: 1200px) 33vw, (min-width: 768px) 50vw, 100vw',
          loading: 'lazy'
        %}
      {%- else -%}
        {{ 'collection-1' | placeholder_svg_tag: 'placeholder-svg' }}
      {%- endif -%}
    </div>
    <div class="collection-card__info">
      <h3 class="collection-card__title">{{ card_title }}</h3>
      {%- if collection.all_products_count != blank -%}
        <span class="collection-card__count caption">{{ 'sections.collection_template.product_count' | t: count: collection.all_products_count }}</span>
      {%- endif -%}
    </div>
  </a>
</div>
