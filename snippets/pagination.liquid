{% comment %}
  Renders pagination controls.
  Accepts:
  - paginate: {Object} Paginate Liquid object
  - anchor: {String} Anchor link suffix (optional)
{% endcomment %}

{%- if paginate.parts.size > 0 -%}
  <nav class="pagination" role="navigation" aria-label="Pagination">
    <ul class="pagination__list list-unstyled" role="list">
      {%- if paginate.previous -%}
        <li class="pagination__item">
          <a
            href="{{ paginate.previous.url }}{{ anchor }}"
            class="pagination__link pagination__link--arrow"
            aria-label="{{ 'general.accessibility.previous' | t }}"
            rel="prev">
            {% render 'icon', icon: 'chevron-left', class: 'icon icon--small' %}
          </a>
        </li>
      {%- endif -%}

      {%- for part in paginate.parts -%}
        <li class="pagination__item">
          {%- if part.is_link -%}
            <a
              href="{{ part.url }}{{ anchor }}"
              class="pagination__link"
              aria-label="{{ 'general.meta.page' | t: page: part.title }}">
              {{- part.title -}}
            </a>
          {%- else -%}
            {%- if part.title == paginate.current_page -%}
              <span
                class="pagination__link pagination__link--current"
                aria-current="page"
                aria-label="{{ 'general.meta.page' | t: page: part.title }}">
                {{- part.title -}}
              </span>
            {%- else -%}
              <span class="pagination__link pagination__link--gap">&hellip;</span>
            {%- endif -%}
          {%- endif -%}
        </li>
      {%- endfor -%}

      {%- if paginate.next -%}
        <li class="pagination__item">
          <a
            href="{{ paginate.next.url }}{{ anchor }}"
            class="pagination__link pagination__link--arrow"
            aria-label="{{ 'general.accessibility.next' | t }}"
            rel="next">
            {% render 'icon', icon: 'chevron-right', class: 'icon icon--small' %}
          </a>
        </li>
      {%- endif -%}
    </ul>
  </nav>
{%- endif -%}

