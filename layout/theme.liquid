<!doctype html>
<html
  class="no-js"
  lang="{{ request.locale.iso_code }}"
  dir="{% if request.locale.iso_code == 'ar' or request.locale.iso_code == 'he' %}rtl{% else %}ltr{% endif %}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">

    {%- render 'meta-tags' -%}

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <!-- Performance: Shopify CDN Preconnect -->
    <link rel="preconnect" href="https://cdn.shopify.com" crossorigin>

    <!-- Preload Primary Font -->
    {%- unless settings.font_body.system? -%}
      {{ settings.font_body | font_url | preload_tag: as: 'font', type: 'font/woff2', crossorigin: 'anonymous' }}
    {%- endunless -%}

    <!-- Root Custom Properties & Stylesheets -->
    {%- render 'css-variables' -%}
    {{ 'base.css' | asset_url | stylesheet_tag }}

    <!-- Structured Data JSON-LD -->
    {%- render 'structured-data' -%}

    {{ content_for_header }}

    <script>
      document.documentElement.className = document.documentElement.className.replace('no-js', 'js');
    </script>
    <script src="{{ 'global.js' | asset_url }}" type="module"></script>
  </head>

  <body class="color-scheme-1" data-scroll-reveal="{{ settings.enable_scroll_reveal }}">
    {%- render 'skip-link' -%}

    {% sections 'header-group' %}

    {%- if settings.show_breadcrumbs -%}
      {%- render 'breadcrumbs' -%}
    {%- endif -%}

    <main id="MainContent" class="content-for-layout focus-none" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {% sections 'overlay-group' %}

    <!-- Cart Accessible Live Region -->
    <div id="cart-live-region" class="visually-hidden" aria-live="polite" role="status"></div>
  </body>
</html>
